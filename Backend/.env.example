# Copy this file to ".env" and fill in real values.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# .env is gitignored, so your secrets never get committed.

# OpenAI secret key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/sigmagpt
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sigmagpt
MONGODB_URI=

# Optional: port the backend listens on (defaults to 8080 if unset)
PORT=8080
